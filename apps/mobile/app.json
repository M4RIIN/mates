{
  "expo": {
    "name": "Mates",
    "slug": "mates",
    "scheme": "mates",
    "version": "0.1.1s",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-web-browser",
      "expo-location"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lagrange.mates",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Mates utilise ta position pour limiter la recherche de lieux au pays dans lequel tu te trouves.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze",
          "uber"
        ],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.737416761863-9p9r3edga5er24bha5s2rf29p9lkul4m"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.lagrange.mates"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "55b47406-99b4-4af7-a683-305cd1238eed"
      }
    },
    "owner": "nclmarin"
  }
}
