{
  "expo": {
    "name": "Mates",
    "slug": "mates",
    "scheme": "mates",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lagrange.mates",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lagrange.mates"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "55b47406-99b4-4af7-a683-305cd1238eed"
      }
    },
    "owner": "nclmarin"
  }
}
