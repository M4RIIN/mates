PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mates
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_DAYS=30
# Comma-separated allowed OAuth client IDs, or use the platform-specific vars below.
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# console | expo | firebase
NOTIFICATION_PROVIDER=console
FIREBASE_SERVICE_ACCOUNT_JSON=
# photon | mapbox | mock
PLACES_PROVIDER=photon
PHOTON_BASE_URL=https://photon.komoot.io
PHOTON_LANGUAGE=fr
# Required only with PLACES_PROVIDER=mapbox.
MAPBOX_ACCESS_TOKEN=
