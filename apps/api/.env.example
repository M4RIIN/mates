PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mates
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_DAYS=30
AUTH_PASSWORD_ENABLED=true
AUTH_GOOGLE_ENABLED=true
# Comma-separated allowed OAuth client IDs, or use the platform-specific vars below.
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# console | expo | firebase
NOTIFICATION_PROVIDER=console
FIREBASE_SERVICE_ACCOUNT_JSON=
# photon | mapbox | mock
PLACES_PROVIDER=photon
PHOTON_BASE_URL=https://photon.komoot.io
PHOTON_LANGUAGE=fr
# Required only with PLACES_PROVIDER=mapbox.
MAPBOX_ACCESS_TOKEN=

# Native Sign in with Apple. Enable after configuring the Apple Developer App ID and key.
AUTH_APPLE_ENABLED=false
APPLE_CLIENT_ID=com.lagrange.mates
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the .p8 key; literal \n separators are supported. Server-only secret.
APPLE_PRIVATE_KEY=
# Stable random secret (32+ bytes) for encrypting Apple refresh tokens. Keep across deployments.
APPLE_TOKEN_ENCRYPTION_SECRET=
